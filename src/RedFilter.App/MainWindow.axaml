<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RedFilter.Views"
        x:Class="RedFilter.MainWindow"
        Title="RedFilter"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Inter, Segoe UI"
        FontSize="15">
  <Grid ColumnDefinitions="248,*">
    <Border Grid.Column="0" Background="#111827" Padding="20,28">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <TextBlock Text="RedFilter" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="This PC and your router" Foreground="#9CA3AF" FontSize="14" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Foreground="#9CA3AF" FontSize="13" TextWrapping="Wrap"
                   Text="Talks only to this computer and the router address you enter."/>
        <StackPanel Margin="0,32,0,0" Spacing="8">
          <Button x:Name="NetworkButton" Classes="nav active" Content="Network" Click="ShowNetwork"/>
          <Button x:Name="RouterButton" Classes="nav" Content="Router" Click="ShowRouter"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="28">
      <views:NetworkView x:Name="NetworkPage"/>
      <views:RouterView x:Name="RouterPage" IsVisible="False"/>
    </Grid>
  </Grid>
</Window>
