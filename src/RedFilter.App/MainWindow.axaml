<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RedFilter.Views"
        xmlns:vm="using:RedFilter.ViewModels"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="RedFilter.MainWindow"
        x:Name="Root"
        Title="RedFilter"
        Width="1320"
        Height="900"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter, Segoe UI"
        FontSize="14"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52"
        WindowDecorations="BorderOnly">
  <Window.Styles>
    <!-- Our own caption buttons: flat, the close button turns red like Windows does. -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46"/>
      <Setter Property="MinWidth" Value="46"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.caption Path">
      <Setter Property="Stroke" Value="{StaticResource MutedBrush}"/>
      <Setter Property="StrokeThickness" Value="1.2"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="Stretch" Value="Uniform"/>
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1F2937"/>
    </Style>
    <Style Selector="Button.caption:pointerover Path">
      <Setter Property="Stroke" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123"/>
    </Style>
    <Style Selector="Button.caption.close:pointerover Path">
      <Setter Property="Stroke" Value="White"/>
    </Style>
    <Style Selector="Button.caption:pressed /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.8"/>
    </Style>

    <Style Selector="Border.modebadge">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.modebadge.on">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Border.modebadge.on Ellipse">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <!-- When maximized, Windows puts part of the window off screen; OffScreenMargin pads that back in. -->
  <Border Padding="{Binding #Root.OffScreenMargin}" Background="{StaticResource BgBrush}">
    <DockPanel>
      <!-- Title bar: drawn by us. The empty area drags the window, double-click maximizes. -->
      <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="52" Background="{StaticResource HeaderBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
              chrome:WindowDecorationProperties.ElementRole="TitleBar"
              PointerPressed="TitleBar_PointerPressed" DoubleTapped="TitleBar_DoubleTapped">
        <Grid ColumnDefinitions="*,Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentBrush}"
                    BoxShadow="0 0 14 0 #66E5383B">
              <TextBlock Text="R" Foreground="White" FontSize="15" FontWeight="Black"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center">
              <Run Text="Red"/><Run Text="Filter" Foreground="{StaticResource AccentBrush}"/>
            </TextBlock>
            <TextBlock Text="Menos lag: prioriza tu juego y controla quién usa tu red" Classes="small" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <!-- Visible from anywhere in the window while the Dota 2 mode is on. -->
          <Border Grid.Column="1" x:Name="ModeBadge" x:DataType="vm:GameModeViewModel" Classes="modebadge" Classes.on="{Binding Active}"
                  VerticalAlignment="Center" CornerRadius="999" Padding="12,4" IsHitTestVisible="False"
                  Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="MODO DOTA 2 ACTIVO" FontSize="11" FontWeight="Bold" LetterSpacing="1.2" Foreground="#FF8A8C"/>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                      chrome:WindowDecorationProperties.ElementRole="User">
            <Button Classes="caption" Click="Minimize_Click" ToolTip.Tip="Minimizar">
              <Path Data="M0,5 L10,5"/>
            </Button>
            <Button Classes="caption" Click="Maximize_Click" x:Name="MaximizeButton" ToolTip.Tip="Maximizar">
              <Path x:Name="MaximizeIcon" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z"/>
            </Button>
            <Button Classes="caption close" Click="Close_Click" ToolTip.Tip="Cerrar">
              <Path Data="M0,0 L10,10 M10,0 L0,10"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Margin="20" RowDefinitions="Auto,16,*">
        <views:GameModeView x:Name="GamePage"/>
        <Grid Grid.Row="2" ColumnDefinitions="5*,16,6*">
          <views:PcView x:Name="PcPage" Grid.Column="0"/>
          <views:WifiView x:Name="WifiPage" Grid.Column="2"/>
        </Grid>
      </Grid>
    </DockPanel>
  </Border>
</Window>
