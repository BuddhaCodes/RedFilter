<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RedFilter.Views"
        x:Class="RedFilter.MainWindow"
        Title="RedFilter"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        FontFamily="Inter, Segoe UI"
        FontSize="14">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#0F172A" Padding="24,14">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="32" Height="32" CornerRadius="8" Background="#2563EB">
          <TextBlock Text="R" Foreground="White" FontSize="16" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="RedFilter" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Prioriza tus programas y controla quién usa tu Wi-Fi" Foreground="#94A3B8" FontSize="12"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Margin="20" ColumnDefinitions="5*,16,6*">
      <views:PcView x:Name="PcPage" Grid.Column="0"/>
      <views:WifiView x:Name="WifiPage" Grid.Column="2"/>
    </Grid>
  </DockPanel>
</Window>
