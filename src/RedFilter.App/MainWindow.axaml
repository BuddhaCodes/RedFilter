<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RedFilter.Views"
        x:Class="RedFilter.MainWindow"
        Title="RedFilter"
        Width="1320"
        Height="880"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter, Segoe UI"
        FontSize="14">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="24,14"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}">
          <TextBlock Text="R" Foreground="White" FontSize="17" FontWeight="Black"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="18" FontWeight="Bold">
            <Run Text="Red"/><Run Text="Filter" Foreground="{StaticResource AccentBrush}"/>
          </TextBlock>
          <TextBlock Text="Menos lag: prioriza tu juego y controla quién usa tu red" Classes="small"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Margin="20" RowDefinitions="Auto,16,*">
      <views:GameModeView x:Name="GamePage"/>
      <Grid Grid.Row="2" ColumnDefinitions="5*,16,6*">
        <views:PcView x:Name="PcPage" Grid.Column="0"/>
        <views:WifiView x:Name="WifiPage" Grid.Column="2"/>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
