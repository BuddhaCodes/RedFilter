<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:RedFilter"
             x:Class="RedFilter.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="Border.owner">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.owner.on">
      <Setter Property="Background" Value="#FFFBEB"/>
      <Setter Property="BorderBrush" Value="#F59E0B"/>
      <Setter Property="BorderThickness" Value="4,1,1,1"/>
    </Style>
    <Style Selector="Border.warn">
      <Setter Property="Background" Value="#FFFBEB"/>
      <Setter Property="BorderBrush" Value="#FCD34D"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="BorderBrush" Value="#F1F5F9"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Background" Value="White"/>
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="#F8FAFC"/>
    </Style>
    <Style Selector="Border.row.owner-row">
      <Setter Property="Background" Value="#FFFBEB"/>
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#EEF2FF"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#3730A3"/>
    </Style>
    <Style Selector="TextBlock.small">
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.rank">
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.small-btn">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="0"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="#B91C1C"/>
      <Setter Property="BorderBrush" Value="#FECACA"/>
      <Setter Property="Background" Value="#FEF2F2"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#2563EB"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.field">
      <Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="20"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

  </Application.Styles>
  <Application.Resources>
    <Color x:Key="SystemAccentColor">#1D4ED8</Color>
  </Application.Resources>
</Application>
