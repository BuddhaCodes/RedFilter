<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RedFilter.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Dark "gamer" palette. Every view uses these brushes instead of literal colours. -->
    <Color x:Key="SystemAccentColor">#E5383B</Color>
    <Color x:Key="SystemAccentColorDark1">#C22F32</Color>
    <Color x:Key="SystemAccentColorLight1">#FF5A5D</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#0B0E13"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#07090D"/>
    <SolidColorBrush x:Key="CardBrush" Color="#121721"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="#18202C"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1C2533"/>
    <SolidColorBrush x:Key="LineBrush" Color="#232D3B"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8C99AB"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#5B6779"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E5383B"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A1416"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#3DDC97"/>
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#0F2A20"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F5B841"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#2B2210"/>
    <SolidColorBrush x:Key="BarTrackBrush" Color="#222B38"/>
    <LinearGradientBrush x:Key="BarBrush" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#E5383B"/>
      <GradientStop Offset="1" Color="#FF8A3D"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#1A1014"/>
      <GradientStop Offset="0.55" Color="#121721"/>
      <GradientStop Offset="1" Color="#0F1A22"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroOnBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#3A0F13"/>
      <GradientStop Offset="0.6" Color="#1B1218"/>
      <GradientStop Offset="1" Color="#121721"/>
    </LinearGradientBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource BgBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
      <Setter Property="BorderBrush" Value="#33415A"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF4B4F"/>
      <Setter Property="BorderBrush" Value="#FF4B4F"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.small-btn">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="0"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="#FF8A8C"/>
      <Setter Property="BorderBrush" Value="#4A1E22"/>
      <Setter Property="Background" Value="#22141A"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A1A20"/>
      <Setter Property="BorderBrush" Value="#E5383B"/>
      <Setter Property="Foreground" Value="#FFB3B4"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.hero">
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="MinWidth" Value="168"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Border.hero">
      <Setter Property="Background" Value="{StaticResource HeroBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
    </Style>
    <Style Selector="Border.hero.on">
      <Setter Property="Background" Value="{StaticResource HeroOnBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BoxShadow" Value="0 0 28 0 #55E5383B"/>
    </Style>
    <Style Selector="Border.owner">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.owner.on">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="4,1,1,1"/>
    </Style>
    <Style Selector="Border.warn">
      <Setter Property="Background" Value="{StaticResource WarnSoftBrush}"/>
      <Setter Property="BorderBrush" Value="#5A4416"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="BorderBrush" Value="#1A222E"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
    </Style>
    <Style Selector="Border.row.owner-row">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,1"/>
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#1E2A3D"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#9DB7FF"/>
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.pill.good">
      <Setter Property="Background" Value="{StaticResource GoodSoftBrush}"/>
      <Setter Property="BorderBrush" Value="#1F5A43"/>
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="Fill" Value="{StaticResource FaintBrush}"/>
    </Style>
    <Style Selector="Ellipse.dot.good">
      <Setter Property="Fill" Value="{StaticResource GoodBrush}"/>
    </Style>
    <Style Selector="Ellipse.dot.hot">
      <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- Text -->
    <Style Selector="TextBlock.small">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.rank">
      <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.5"/>
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.hero-title">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="1"/>
    </Style>
    <Style Selector="TextBlock.field">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style Selector="TextBlock.warn-text">
      <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
    </Style>
    <Style Selector="TextBlock.hot">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
  </Application.Styles>
</Application>
