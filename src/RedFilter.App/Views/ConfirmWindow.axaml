<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedFilter.Views.ConfirmWindow"
        Title="RedFilter"
        Width="520"
        MinHeight="160"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource CardBrush}"
        FontFamily="Inter, Segoe UI">
  <StackPanel Margin="28" Spacing="20">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="15" LineHeight="22"/>
    <TextBox x:Name="InputBox" IsVisible="False"/>
    <WrapPanel x:Name="Buttons" HorizontalAlignment="Right"/>
  </StackPanel>
</Window>
