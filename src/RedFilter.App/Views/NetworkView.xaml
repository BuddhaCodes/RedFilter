<UserControl x:Class="RedFilter.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{Binding OwnerText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Elevation}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Limit other programs" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox Width="200" Margin="0,0,12,0"
                ItemsSource="{Binding ThrottleChoices}"
                SelectedItem="{Binding Throttle}"
                DisplayMemberPath="Label"/>
      <Button Content="Give the network to the selected program"
              Style="{StaticResource PrimaryButton}"
              IsEnabled="{Binding CanGiveNetwork}"
              Click="GiveNetwork_Click"/>
      <Button Content="Turn filter off"
              Style="{StaticResource QuietButton}"
              IsEnabled="{Binding CanTurnOff}"
              Click="TurnOff_Click"/>
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
               Text="Windows QoS matches a program path and limits outbound traffic. Download bytes are not capped. System processes stay unthrottled. TCP rates come from Windows connection statistics; UDP endpoints are counted only. Giving a program the network, or turning the filter off, asks Windows for administrator approval and restarts RedFilter. The filter stays on after you close this window until you turn it off, and it clears on reboot."/>

    <DataGrid ItemsSource="{Binding Processes}"
              SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              BorderBrush="{StaticResource Line}"
              RowHeight="32"
              CanUserAddRows="False">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsOwner}" Value="True">
              <Setter Property="Background" Value="#FEF3C7"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
        <DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="110"/>
        <DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="110"/>
        <DataGridTextColumn Header="Connections" Binding="{Binding Connections}" Width="110"/>
        <DataGridTextColumn Header="Program path" Binding="{Binding Path}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
