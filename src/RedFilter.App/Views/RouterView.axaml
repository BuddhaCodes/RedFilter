<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RedFilter.ViewModels"
             x:Class="RedFilter.Views.RouterView"
             x:DataType="vm:RouterViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Router address" Classes="field"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Content="Use default gateway" Click="Gateway_Click"/>
          </Grid>
          <TextBlock Text="Admin username" Classes="field" Margin="0,10,0,6"/>
          <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Admin password" Classes="field" Margin="0,10,0,6"/>
          <TextBox x:Name="PasswordBox" PasswordChar="●"/>
          <TextBlock Text="{Binding PasswordNote}" Classes="note" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="Brand" Classes="field"/>
          <ComboBox MinHeight="40" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Brands}"
                    SelectedItem="{Binding SelectedBrand, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BrandChoice">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Model" Classes="field" Margin="0,10,0,6"/>
          <TextBox Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <WrapPanel Margin="0,8,0,0">
            <Button Content="Save" Margin="0,0,8,8" Click="Save_Click"/>
            <Button Content="Test connection" Classes="accent" Margin="0,0,8,8" Click="Test_Click"/>
            <Button Content="Refresh clients" Margin="0,0,8,8" Click="Refresh_Click"/>
            <Button Content="Clear saved password" Margin="0,0,8,8" Click="ClearPassword_Click"/>
          </WrapPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#111827"/>
        <TextBlock Text="{Binding Top}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#111827"/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" Spacing="8">
      <WrapPanel>
        <Button Content="Disconnect from Wi-Fi" Classes="accent" Margin="0,0,8,8" IsEnabled="{Binding CanDisconnect}" Click="Disconnect_Click"/>
        <Button Content="Block for 30 minutes" Margin="0,0,8,8" IsEnabled="{Binding CanBlock}" Click="Block_Click"/>
        <Button Content="Unblock" Margin="0,0,8,8" IsEnabled="{Binding CanUnblock}" Click="Unblock_Click"/>
        <Button Content="Allow reconnect" Margin="0,0,8,8" IsEnabled="{Binding CanAllowReconnect}" Click="Reconnect_Click"/>
      </WrapPanel>
      <WrapPanel>
        <Button Content="Prioritize" Margin="0,0,8,8" IsEnabled="{Binding CanPrioritize}" IsVisible="{Binding ShowPriority}" Click="Prioritize_Click"/>
        <Button Content="Clear priority" Margin="0,0,8,8" IsEnabled="{Binding CanClearPriority}" IsVisible="{Binding ShowPriority}" Click="ClearPriority_Click"/>
        <Button Content="Wake on LAN" Margin="0,0,8,8" IsEnabled="{Binding CanWake}" IsVisible="{Binding ShowWake}" Click="Wake_Click"/>
      </WrapPanel>
    </StackPanel>

    <DataGrid x:CompileBindings="False"
              ItemsSource="{Binding Clients}"
              SelectedItem="{Binding Selected, Mode=TwoWay}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserReorderColumns="False"
              GridLinesVisibility="Horizontal"
              BorderBrush="#E5E7EB"
              BorderThickness="1"
              RowHeight="40">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Top" Binding="{Binding Rank}" Width="70"/>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="160"/>
        <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="140"/>
        <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="*"/>
        <DataGridTextColumn Header="Usage" Binding="{Binding Usage}" Width="200"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
