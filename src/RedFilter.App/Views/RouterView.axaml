<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RedFilter.ViewModels"
             xmlns:aconv="using:Avalonia.Data.Converters"
             x:Class="RedFilter.Views.RouterView"
             x:DataType="vm:RouterViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16" Spacing="2">
      <TextBlock Classes="kicker" Text="YOUR ROUTER"/>
      <TextBlock Classes="page-title" Text="Router"/>
    </StackPanel>

    <Border DockPanel.Dock="Top" Classes="card banner" Margin="0,0,0,16">
      <StackPanel Spacing="6">
        <TextBlock Classes="kicker" Text="ROUTER STATUS" Foreground="#64748B"/>
        <TextBlock Text="{Binding Status}" FontSize="18" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" LineHeight="26"/>
        <TextBlock Text="{Binding Top}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   TextWrapping="Wrap"
                   IsVisible="{Binding Top, Converter={x:Static aconv:StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16">
      <StackPanel Spacing="0">
        <TextBlock Classes="section" Text="Sign in"/>
        <TextBlock Classes="note" Margin="0,4,0,16"
                   Text="Address, username, and password for your own router. The password stays on this PC."/>
        <Grid ColumnDefinitions="*,28,*">
          <StackPanel Grid.Column="0" Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="field" Text="Router address"/>
              <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Grid.Column="0" Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="2" Content="Use default gateway" Click="Gateway_Click"/>
              </Grid>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="field" Text="Admin username"/>
              <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="field" Text="Admin password"/>
              <TextBox x:Name="PasswordBox" PasswordChar="●"/>
              <TextBlock Text="{Binding PasswordNote}" Classes="note"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="field" Text="Brand"/>
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Brands}"
                        SelectedItem="{Binding SelectedBrand, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BrandChoice">
                    <TextBlock Text="{Binding Label}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="field" Text="Model"/>
              <TextBox Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border Classes="toolbar">
          <WrapPanel>
            <Button Content="Test connection" Classes="accent" Margin="0,0,8,0" Click="Test_Click"/>
            <Button Content="Save" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Refresh clients" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="Clear saved password" Margin="0,0,8,0" Click="ClearPassword_Click"/>
          </WrapPanel>
        </Border>
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" Classes="note"
               Text="RedFilter contacts only the address you enter. It does not guess a password or scan the network. Disconnect, block, and unblock each send one admin request for the selected client."/>

    <Border Classes="table-card" MinHeight="240">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="0">
          <TextBlock Classes="section" Text="Connected clients" Margin="16,12,16,4"/>
          <TextBlock Classes="note" Text="Select a client, then disconnect it or use the other actions this router supports." Margin="16,0,16,8"/>
          <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,0,16,12">
            <StackPanel Spacing="8">
              <WrapPanel>
                <Button Content="Disconnect from Wi-Fi" Classes="accent" Margin="0,0,8,8" IsEnabled="{Binding CanDisconnect}" Click="Disconnect_Click"/>
                <Button Content="Block for 30 minutes" Margin="0,0,8,8" IsEnabled="{Binding CanBlock}" Click="Block_Click"/>
                <Button Content="Unblock" Margin="0,0,8,8" IsEnabled="{Binding CanUnblock}" Click="Unblock_Click"/>
                <Button Content="Allow reconnect" Margin="0,0,8,8" IsEnabled="{Binding CanAllowReconnect}" Click="Reconnect_Click"/>
              </WrapPanel>
              <WrapPanel>
                <Button Content="Prioritize" Margin="0,0,8,0" IsEnabled="{Binding CanPrioritize}" IsVisible="{Binding ShowPriority}" Click="Prioritize_Click"/>
                <Button Content="Clear priority" Margin="0,0,8,0" IsEnabled="{Binding CanClearPriority}" IsVisible="{Binding ShowPriority}" Click="ClearPriority_Click"/>
                <Button Content="Wake on LAN" Margin="0,0,8,0" IsEnabled="{Binding CanWake}" IsVisible="{Binding ShowWake}" Click="Wake_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <TableView Grid.Row="1"
                   MinHeight="160"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   x:CompileBindings="False"
                   ItemsSource="{Binding Clients}"
                   SelectedItem="{Binding Selected, Mode=TwoWay}"
                   SelectionMode="Single"
                   CanUserResizeColumns="False">
          <TableView.Columns>
            <TableViewColumn Header="Top" Binding="{Binding Rank}" Width="72"/>
            <TableViewColumn Header="Name" Binding="{Binding Name}" Width="180"/>
            <TableViewColumn Header="MAC" Binding="{Binding Mac}" Width="160"/>
            <TableViewColumn Header="IP" Binding="{Binding Ip}" Width="140"/>
            <TableViewColumn Header="Connection" Binding="{Binding Connection}" Width="*"/>
            <TableViewColumn Header="Usage" Binding="{Binding Usage}" Width="220"/>
          </TableView.Columns>
        </TableView>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
