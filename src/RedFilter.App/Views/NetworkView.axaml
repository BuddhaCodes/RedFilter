<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RedFilter.ViewModels"
             x:Class="RedFilter.Views.NetworkView"
             x:DataType="vm:NetworkViewModel"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="2">
      <TextBlock Classes="kicker" Text="THIS PC"/>
      <TextBlock Classes="page-title" Text="Network"/>
    </StackPanel>

    <Border Grid.Row="1" Classes="card banner" Classes.owning="{Binding FilterOn}" Margin="0,0,0,16">
      <StackPanel Spacing="8">
        <TextBlock Text="NETWORK OWNER" IsVisible="{Binding FilterOn}" Foreground="#92400E" Classes="kicker"/>
        <TextBlock Text="NO FILTER" IsVisible="{Binding !FilterOn}" Foreground="#64748B" Classes="kicker"/>
        <TextBlock Text="{Binding OwnerText}" FontSize="24" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" LineHeight="32"/>
        <Border Height="1" Background="#E5E7EB" Margin="0,4,0,4"/>
        <TextBlock Text="{Binding Elevation}" Classes="note"/>
        <TextBlock Text="{Binding Status}" Foreground="#111827" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Classes="card" Margin="0,0,0,16">
      <StackPanel Spacing="0">
        <TextBlock Classes="section" Text="Give one program the network"/>
        <TextBlock Classes="note" Margin="0,6,0,0"
                   Text="Pick a row in the table, choose how tightly other programs are limited, then give that program the network."/>
        <TextBlock Classes="field" Margin="0,16,0,6" Text="Limit other programs"/>
        <ComboBox Width="260" HorizontalAlignment="Left"
                  ItemsSource="{Binding ThrottleChoices}"
                  SelectedItem="{Binding Throttle}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ThrottleChoice">
              <TextBlock Text="{Binding Label}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Border Classes="toolbar">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Give the network to the selected program"
                    Classes="accent"
                    IsEnabled="{Binding CanGiveNetwork}"
                    Click="GiveNetwork_Click"/>
            <Button Content="Turn filter off"
                    IsEnabled="{Binding CanTurnOff}"
                    Click="TurnOff_Click"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="4" Margin="0,12,0,0" Classes="note"
               Text="Windows QoS matches a program path and limits outbound traffic. Download bytes are not capped. System processes stay unthrottled. TCP rates come from Windows connection statistics; UDP endpoints are counted only. Giving a program the network, or turning the filter off, asks Windows for administrator approval and restarts RedFilter. The filter stays on after you close this window until you turn it off, and it clears on reboot."/>

    <Border Grid.Row="3" Classes="table-card" MinHeight="220">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
          <TextBlock Classes="section" Text="Running programs"/>
        </Border>
        <DataGrid x:Name="ProcessGrid"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="False"
                  SelectionChanged="ProcessGrid_SelectionChanged">
          <DataGrid.Styles>
            <Style Selector="DataGridRow">
              <Setter Property="Background" Value="{Binding IsOwner, Converter={StaticResource OwnerRowBrush}}"/>
              <Setter Property="FontWeight" Value="{Binding IsOwner, Converter={StaticResource OwnerFontWeight}}"/>
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Owns the network" Binding="{Binding OwnerLabel}" Width="150"/>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
            <DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="120"/>
            <DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="120"/>
            <DataGridTextColumn Header="Connections" Binding="{Binding Connections}" Width="120"/>
            <DataGridTextColumn Header="Program path" Binding="{Binding Path}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
