<UserControl x:Class="RedFilter.Views.RouterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Router address" Style="{StaticResource FieldLabel}"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Use default gateway" Style="{StaticResource QuietButton}" Margin="8,0,0,10" Click="Gateway_Click"/>
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
          <TextBlock Text="Admin username" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Admin password" Style="{StaticResource FieldLabel}"/>
          <PasswordBox x:Name="Password" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding PasswordNote}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Brand" Style="{StaticResource FieldLabel}"/>
          <ComboBox Margin="0,0,0,10"
                    ItemsSource="{Binding Brands}"
                    SelectedValue="{Binding Brand}"
                    SelectedValuePath="Id"
                    DisplayMemberPath="Label"/>
          <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Save" Style="{StaticResource QuietButton}" Click="Save_Click"/>
            <Button Content="Test connection" Style="{StaticResource PrimaryButton}" Click="Test_Click"/>
            <Button Content="Refresh clients" Style="{StaticResource QuietButton}" Click="Refresh_Click"/>
            <Button Content="Clear saved password" Style="{StaticResource QuietButton}" Click="ClearPassword_Click"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Top}" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="Disconnect from Wi-Fi" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanDisconnect}" Click="Disconnect_Click"/>
        <Button Content="Block for 30 minutes" Style="{StaticResource QuietButton}" IsEnabled="{Binding CanBlock}" Click="Block_Click"/>
        <Button Content="Unblock" Style="{StaticResource QuietButton}" IsEnabled="{Binding CanUnblock}" Click="Unblock_Click"/>
        <Button Content="Allow reconnect" Style="{StaticResource QuietButton}" IsEnabled="{Binding CanAllowReconnect}" Click="Reconnect_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="Prioritize" Style="{StaticResource QuietButton}" IsEnabled="{Binding CanPrioritize}" Visibility="{Binding ShowPriority, Converter={StaticResource BoolVis}}" Click="Prioritize_Click"/>
        <Button Content="Clear priority" Style="{StaticResource QuietButton}" IsEnabled="{Binding CanClearPriority}" Visibility="{Binding ShowPriority, Converter={StaticResource BoolVis}}" Click="ClearPriority_Click"/>
        <Button Content="Wake on LAN" Style="{StaticResource QuietButton}" IsEnabled="{Binding CanWake}" Visibility="{Binding ShowWake, Converter={StaticResource BoolVis}}" Click="Wake_Click"/>
      </StackPanel>
    </StackPanel>

    <DataGrid ItemsSource="{Binding Clients}"
              SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              BorderBrush="{StaticResource Line}"
              RowHeight="32"
              CanUserAddRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Top" Binding="{Binding Rank}" Width="50"/>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="150"/>
        <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="130"/>
        <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="*"/>
        <DataGridTextColumn Header="Usage" Binding="{Binding Usage}" Width="180"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
